<view class="order-page" wx:if="{{order}}">
  <view class="card status-card">
    <view class="status">{{order.status}}</view>
    <view class="meta">下单时间：{{order.createdAt}}</view>
    <view class="order-id">
      <text>订单编号：{{order.id}}</text>
      <text class="copy" bindtap="copyOrderId">复制</text>
    </view>
  </view>

  <view class="card address-card">
    <view class="section-title">收货信息</view>
    <view class="address-line">{{order.address.name}} {{order.address.phone}}</view>
    <view class="address-line">{{order.address.detail}}</view>
  </view>

  <view class="card items-card">
    <view class="section-title">商品信息</view>
    <block wx:for="{{order.items}}" wx:key="productId">
      <view class="item">
        <image class="thumb" src="{{item.image}}" mode="aspectFill" />
        <view class="info">
          <view class="name">{{item.name}}</view>
          <view class="meta">¥{{item.price}} × {{item.quantity}}</view>
          <view class="subtotal">小计：¥{{item.subtotal}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="card logistics-card">
    <view class="section-title">物流动态</view>
    <block wx:for="{{order.logistics}}" wx:key="timestamp">
      <view class="logistics-item">
        <view class="timeline">
          <view class="dot {{index === 0 ? 'active' : ''}}"></view>
          <view class="line" wx:if="{{index !== order.logistics.length - 1}}"></view>
        </view>
        <view class="logistics-info">
          <view class="status">{{item.status}}</view>
          <view class="time">{{item.timestamp}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="card summary-card">
    <view class="summary-row">
      <text>商品总额</text>
      <text>¥{{order.totalPrice}}</text>
    </view>
    <view class="summary-row">
      <text>支付方式</text>
      <text>{{order.paymentMethod === 'wechat' ? '微信支付' : order.paymentMethod === 'alipay' ? '支付宝' : '银行卡'}}</text>
    </view>
  </view>

  <navigator url="/pages/index/index" class="primary-button go-index">继续逛逛</navigator>
</view>

<view wx:else class="empty-state">暂无订单信息</view>
