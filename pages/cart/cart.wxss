.cart-page {
  padding: 32rpx;
  padding-bottom: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cart-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.selector {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #d4a373;
  display: flex;
  align-items: center;
  justify-content: center;
}

.selector-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
}

.selector-icon.checked {
  background: #d4a373;
}

.thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.qty {
  font-size: 26rpx;
  color: #9f9f9f;
}

.item-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #4f4f4f;
}

.quantity {
  font-size: 30rpx;
  font-weight: 600;
}

.remove {
  color: #d23c3c;
  font-size: 26rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
}

.empty-desc {
  color: #9f9f9f;
  font-size: 26rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #ffffff;
  padding: 24rpx 32rpx calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.05);
}

.summary {
  flex: 1;
}

.total-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #c28b37;
}

.total-quantity {
  font-size: 26rpx;
  color: #8f8f8f;
  margin-top: 8rpx;
}

.checkout-button {
  background: linear-gradient(135deg, #d4a373, #e6c68f);
  color: #ffffff;
  padding: 24rpx 48rpx;
  border-radius: 100rpx;
  font-size: 32rpx;
  font-weight: 600;
}
