.product-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 160rpx;
}

.gallery {
  height: 520rpx;
}

.gallery-image {
  width: 100%;
  height: 520rpx;
}

.product-summary {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.original-price {
  font-size: 26rpx;
  color: #b3b3b3;
  text-decoration: line-through;
}

.description {
  font-size: 28rpx;
  color: #4f4f4f;
  line-height: 1.6;
}

.spec-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.spec-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.spec-item {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #555555;
}

.spec-label {
  color: #8f8f8f;
  min-width: 180rpx;
}

.quantity-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.quantity-controller {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.quantity-button {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #444444;
}

.quantity {
  font-size: 32rpx;
  font-weight: 600;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 24rpx;
}

.action {
  flex: 1;
  border-radius: 100rpx;
  text-align: center;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
}

.action.secondary {
  border: 2rpx solid #d28f3c;
  color: #d28f3c;
}

.action.primary {
  background: linear-gradient(135deg, #d4a373, #e6c68f);
  color: #ffffff;
}

.empty-state {
  padding: 120rpx 0;
  text-align: center;
  color: #9f9f9f;
}
