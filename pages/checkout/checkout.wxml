<view class="checkout-page">
  <view class="card address-card">
    <view class="section-title">收货信息</view>
    <view class="form-row">
      <text class="label">收货人</text>
      <input
        class="input"
        placeholder="请输入收货人姓名"
        value="{{address.name}}"
        data-field="name"
        bindinput="handleInput"
      />
    </view>
    <view class="form-row">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        placeholder="请输入11位手机号"
        maxlength="11"
        value="{{address.phone}}"
        data-field="phone"
        bindinput="handleInput"
      />
    </view>
    <view class="form-row">
      <text class="label">详细地址</text>
      <textarea
        class="textarea"
        placeholder="请填写省市区+街道门牌号"
        value="{{address.detail}}"
        data-field="detail"
        bindinput="handleInput"
      />
    </view>
  </view>

  <view class="card items-card">
    <view class="section-title">商品清单</view>
    <block wx:for="{{items}}" wx:key="productId">
      <view class="item">
        <image class="thumb" src="{{item.image}}" mode="aspectFill" />
        <view class="info">
          <view class="name">{{item.name}}</view>
          <view class="meta">¥{{item.price}} × {{item.quantity}}</view>
          <view class="subtotal">小计：¥{{item.subtotal}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="card payment-card">
    <view class="section-title">支付方式</view>
    <view class="payment-options">
      <block wx:for="{{paymentOptions}}" wx:key="key">
        <view
          class="payment-option {{paymentMethod === item.key ? 'active' : ''}}"
          data-method="{{item.key}}"
          bindtap="choosePayment"
        >
          <view class="radio {{paymentMethod === item.key ? 'active' : ''}}"></view>
          <text class="label-text">{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="card summary-card">
    <view class="section-title">订单金额</view>
    <view class="summary-row">
      <text>商品总额</text>
      <text>¥{{totalPrice}}</text>
    </view>
    <view class="summary-row">
      <text>运费</text>
      <text>¥0.00</text>
    </view>
    <view class="summary-row total">
      <text>应付总额</text>
      <text>¥{{totalPrice}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="amount">应付金额 ¥{{totalPrice}}</view>
    <view class="submit-button" bindtap="submitOrder">立即支付</view>
  </view>
</view>
